# Game backend (server/) — copy relevant vars into .env, never commit .env itself.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_game
API_PORT=4001
CORS_ORIGIN=http://localhost:5173

# Front-end (game entry) — set only if the API isn't on the default localhost:4001.
VITE_API_URL=http://localhost:4001
